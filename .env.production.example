# ── PRODUCTION (.env kwenye SERVER tu — usiweke kwenye GitHub) ──
# Copia faili hii kwenye server: /home/mussa/church_system/church_management/.env

# Django Security
SECRET_KEY=badilisha-na-token-refu-random
DEBUG=False
ALLOWED_HOSTS=168.144.86.21,127.0.0.1,localhost

# HTTP (bila SSL) — tumia hizi hadi uweke Certbot
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://168.144.86.21,http://168.144.86.21:8000

# Baada ya SSL (domain + Certbot) — badilisha kuwa:
# ALLOWED_HOSTS=kanisa.org,www.kanisa.org,168.144.86.21
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://kanisa.org,https://www.kanisa.org

# PostgreSQL (DigitalOcean server)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=church_system
DB_USER=mussa
DB_PASSWORD=weka-password-yako-hapa
DB_HOST=localhost
DB_PORT=5432

# SMS
# Set True if Nginx does not serve /media/ yet (picha za wasifu)
SERVE_MEDIA_FILES=True

SMS_DEVELOPMENT_MODE=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_ID=
TWILIO_PHONE_NUMBER=

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PHM-ARCC <noreply@kanisa.org>
