# =============================================================================
# .env.production.example — KIOLEZO cha SERVER (live)
# =============================================================================
# Jinsi ya kutumia:
#   1. Kwenye server:  cp .env.production.example .env
#   2. Jaza thamani halisi (SECRET_KEY, passwords, domain)
#   3. Hakikisha .env haipo kwenye git (imekwisha kwenye .gitignore)
#
# Hii faili haifanyi kazi yenyewe — ni mwongozo tu.
# =============================================================================


# ── LAZIMA ───────────────────────────────────────────────────────────────────

# Lazima iwe random na refu — usitumie mfano huu kwenye server halisi!
SECRET_KEY=badilisha-na-token-refu-random-50-characters-minimum

# Lazima False kwenye internet (usionyeshe makosa ya ndani kwa watu)
DEBUG=False

# Domain yako + IP ya server (koma, bila nafasi)
# Mfano: phm-arcc.org,www.phm-arcc.org,168.144.86.21
ALLOWED_HOSTS=phm-arcc.org,www.phm-arcc.org,168.144.86.21,127.0.0.1,localhost

# Lazima iendane na URL unayotumia kuingia (http AU https)
# HTTP (bila SSL): http://168.144.86.21
# HTTPS (na domain): https://phm-arcc.org,https://www.phm-arcc.org
CSRF_TRUSTED_ORIGINS=https://phm-arcc.org,https://www.phm-arcc.org,http://168.144.86.21

# Njia siri ya admin — si "admin/"
# Chagua string isiyojulikana (herufi+nambari). Mfano: phm-manage-k7x2m9p4/
ADMIN_URL=phm-manage-badilisha-hii/

# IP zilizoruhusiwa kufungua admin (hiari). Acha tupu = ruhusu popote.
# Mfano: 127.0.0.1,168.144.86.21
# ADMIN_ALLOWED_IPS=

# Kuzuia brute-force kwenye admin login
ADMIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_RATE_LIMIT_LOCKOUT=900

# Njia ya kuingia (si /members/login/). Weka sawa na VITE_LOGIN_URL kwenye tovuti.
LOGIN_URL_PATH=phm-kuingia-a8f2/


# ── DATABASE (PostgreSQL kwenye server) ──────────────────────────────────────

DB_ENGINE=django.db.backends.postgresql
DB_NAME=church_system
DB_USER=mussa
DB_PASSWORD=weka-password-yako-hapa
DB_HOST=localhost
DB_PORT=5432


# ── Picha na faili (posters, logo) ───────────────────────────────────────────

# False = Nginx inatoa /media/ (inashauriwa ikiwa Nginx imewekwa)
# True  = Django inatoa /media/ (rahisi ikiwa bado haujaunganisha Nginx)
SERVE_MEDIA_FILES=False


# ── Usalama wa kuingia ───────────────────────────────────────────────────────

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT=900
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
REGISTER_RATE_LIMIT_ATTEMPTS=5

# Ficha teknolojia (Django/Python) kutoka headers na cookies
HIDE_TECH_STACK=True
# SERVER_SIGNATURE=webserver
# CSRF_COOKIE_NAME=phmarcc_xsrf


# ── HTTP bila SSL (mwanzo tu) ───────────────────────────────────────────────
# Tumia hizi hadi uweke Certbot (HTTPS). Kisha badilisha kama chini.

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Baada ya HTTPS (Certbot) — BADILISHA kuwa hivi ───────────────────────────
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://phm-arcc.org,https://www.phm-arcc.org
# ALLOWED_HOSTS=phm-arcc.org,www.phm-arcc.org,168.144.86.21
# SECURE_HSTS_SECONDS=31536000


# ── SMS (hiari) ──────────────────────────────────────────────────────────────

SMS_DEVELOPMENT_MODE=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_ID=
TWILIO_PHONE_NUMBER=


# ── EMAIL (hiari — reset password) ───────────────────────────────────────────
# Jaza ikiwa unataka watumiaji wapate link ya kubadilisha password kwa email.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PHM-ARCC <noreply@kanisa.org>
