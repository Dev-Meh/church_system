# Django Security
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://168.144.86.21,http://168.144.86.21:8000

# Database Configuration
# For SQLite (default local)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For PostgreSQL (production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=church
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# DB_HOST=localhost
# DB_PORT=5432

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SERVICE_ID=your_messaging_service_sid (optional)
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SMS_DEVELOPMENT_MODE=True

# Bootstrap scripts (create_superadmin.py, create_pastor_user.py, etc.)
# Copy values into .env only on your machine — NEVER commit .env or real passwords to git.
CHURCH_ADMIN_PASSWORD=
CHURCH_ADMIN_USERNAME=admin
CHURCH_ADMIN_EMAIL=admin@church.com
# CHURCH_ADMIN_RESET=1

CHURCH_PASTOR_PASSWORD=
CHURCH_PASTOR_USERNAME=pastor
CHURCH_PASTOR_EMAIL=pastor@church.com
# CHURCH_PASTOR_RESET=1

CHURCH_MEMBER_PASSWORD=
CHURCH_MEMBER_USERNAME=member
CHURCH_MEMBER_EMAIL=member@church.com
# CHURCH_MEMBER_RESET=1

# create_test_users.py (local dev only)
CHURCH_DEV_PASTOR_PASSWORD=
CHURCH_DEV_MEMBER_PASSWORD=
