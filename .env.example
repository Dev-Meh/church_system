# =============================================================================
# .env.example — KIOLEZO cha kompyuta yako (development)
# =============================================================================
# Jinsi ya kutumia:
#   1. Nakili faili hii:  copy .env.example .env
#   2. Jaza thamani halisi kwenye .env
#   3. USIWEKE .env kwenye GitHub (siri zako)
#
# Faili .env ndiyo inayosomwa na Django (settings.py).
# Hii (.env.example) ni mwongozo tu — haifanyi kazi yenyewe mpaka uinakili.
# =============================================================================


# ── LAZIMA (mfumo hauendi bila hizi) ─────────────────────────────────────────

# Siri ya Django — inalinda sessions, cookies, n.k.
# Development: unaweza kuacha kama ilivyo. Production: LAZIMA ubadilishe (random 50+ chars).
SECRET_KEY=your-secret-key-here

# True = uone makosa kwa undani (PC tu). Production: lazima False.
DEBUG=True

# Domain/IP zinazoruhusiwa kufungua mfumo. Tenganisha kwa koma.
# Mfano PC: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Anwani za kuruhusu fomu (login, michango) zisikataliwe na CSRF.
# Weka ikiwa unatumia IP au port tofauti, mfano: http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# ── DATABASE (chagua moja) ───────────────────────────────────────────────────

# SQLite — rahisi kwa PC (default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL — tumia kwenye server (ondoa # mbele ya mistari hii)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=church
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# DB_HOST=localhost
# DB_PORT=5432


# ── USALAMA (inashauriwa kubadilisha kwenye server) ─────────────────────────

# Njia ya kufungua Django admin. Usitumie "admin/" wazi kwenye internet.
# Mfano: phm-manage-k7x2/  (lazima iishie na /)
ADMIN_URL=admin/

# Njia ya kuingia (si /members/login/). /members/login/ bado inaelekeza hapa.
# Mfano: phm-kuingia-a8f2/
LOGIN_URL_PATH=phm-kuingia-a8f2/

# Kuzuia kujaribu password mara nyingi: majaribio 5, kufungwa sekunde 900 (dakika 15)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT=900
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
REGISTER_RATE_LIMIT_ATTEMPTS=5

# HTTP tu (PC). Kwenye server na HTTPS, tumia .env.production.example
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# True = Django inatoa picha (posters, logo) moja kwa moja — sawa kwa PC.
# Kwenye server na Nginx, weka False (Nginx inatoa /media/).
SERVE_MEDIA_FILES=True


# ── SMS (hiari — ikiwa hutumi SMS bado) ─────────────────────────────────────

# True = SMS haiondoki nje, inaandikwa console tu (salama kwa majaribio)
SMS_DEVELOPMENT_MODE=True

# Twilio — jaza tu ukishatuma SMS halisi
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_ID=
TWILIO_PHONE_NUMBER=


# ── EMAIL (hiari — reset password kwa barua pepe) ───────────────────────────
# Ikiwa haujaji, acha tupu; reset password inaweza kushindwa bila SMTP.

# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PHM-ARCC <noreply@example.com>


# ── HIARI SANA — scripts za kwanza tu (si kila siku) ─────────────────────────
# Tumia wakati wa kuunda admin/pastor/member kwa mara ya kwanza:
#   python create_superadmin.py
#   python create_pastor_user.py
# Weka password kwenye .env, usi-commit. Baada ya kuunda, unaweza kufuta mistari.

# CHURCH_ADMIN_PASSWORD=
# CHURCH_ADMIN_USERNAME=admin
# CHURCH_ADMIN_EMAIL=admin@church.com

# CHURCH_PASTOR_PASSWORD=
# CHURCH_PASTOR_USERNAME=pastor

# CHURCH_MEMBER_PASSWORD=
# CHURCH_MEMBER_USERNAME=member

# CHURCH_DEV_PASTOR_PASSWORD=
# CHURCH_DEV_MEMBER_PASSWORD=
